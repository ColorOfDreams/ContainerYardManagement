{
  "info": {
    "_postman_id": "b6b0a0d0-6c9a-4e2a-9a0a-cyms-management-service",
    "name": "CYMS - Management Service",
    "description": "Tự động test toàn bộ API hiện có của Management Service (Auth, RBAC, Contract). Chạy bằng Collection Runner (hoặc Newman) từ trên xuống dưới, KHÔNG cần click từng request — mỗi request có sẵn script test (pass/fail) và tự lưu id/token cần cho request kế tiếp.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "adminEmail", "value": "admin@example.local" },
    { "key": "adminPassword", "value": "ReplaceWith6PlusCharsAndANumber" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "permissionCode", "value": "" },
    { "key": "permissionId", "value": "" },
    { "key": "roleCode", "value": "" },
    { "key": "roleId", "value": "" },
    { "key": "testUserEmail", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "contractId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Service is up (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login OK (200)', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Response has accessToken + refreshToken', () => {",
                  "  pm.expect(json.accessToken).to.be.a('string');",
                  "  pm.expect(json.refreshToken).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refresh token (rotate)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh OK (200)', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Got a NEW token pair (rotation)', () => {",
                  "  pm.expect(json.accessToken).to.be.a('string');",
                  "  pm.expect(json.refreshToken).to.be.a('string');",
                  "});",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Permissions",
      "item": [
        {
          "name": "Create permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{permissionCode}}\",\n  \"name\": \"Automated test permission\",\n  \"description\": \"Created by Postman Collection Runner\"\n}" },
            "url": { "raw": "{{baseUrl}}/permissions", "host": ["{{baseUrl}}"], "path": ["permissions"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('permissionCode', 'test:perm-' + Date.now());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Permission created (201)', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('permissionId', json.permissionId);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List permissions",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/permissions", "host": ["{{baseUrl}}"], "path": ["permissions"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('List OK (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Roles",
      "item": [
        {
          "name": "Create role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{roleCode}}\",\n  \"name\": \"Automated test role\",\n  \"permissionCodes\": [\"{{permissionCode}}\"]\n}" },
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('roleCode', 'TEST_ROLE_' + Date.now());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Role created (201)', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('roleId', json.roleId);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('List OK (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"TestUser1\",\n  \"displayName\": \"Automated Test User\",\n  \"roleCodes\": [\"{{roleCode}}\"]\n}" },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('testUserEmail', 'test.user.' + Date.now() + '@example.local');"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User created (201)', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('userId', json.userId);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('List OK (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "response": []
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Get OK (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "response": []
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"Automated Test User (updated)\"\n}" },
            "url": { "raw": "{{baseUrl}}/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{userId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Update OK (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Contracts",
      "item": [
        {
          "name": "Create contract",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{$guid}}\",\n  \"effectiveDate\": \"2026-01-01\",\n  \"expiryDate\": \"2027-01-01\",\n  \"unitPrice\": 120.5,\n  \"freeTimeDays\": 7,\n  \"surchargeRate\": 0.05,\n  \"paymentTerms\": \"Net 30 (automated test)\"\n}" },
            "url": { "raw": "{{baseUrl}}/contracts", "host": ["{{baseUrl}}"], "path": ["contracts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Contract created (201)', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Status starts as Draft', () => pm.expect(json.status).to.eql('Draft'));",
                  "pm.collectionVariables.set('contractId', json.contractId);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List contracts",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/contracts", "host": ["{{baseUrl}}"], "path": ["contracts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('List OK (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "response": []
        },
        {
          "name": "Get contract by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/contracts/{{contractId}}", "host": ["{{baseUrl}}"], "path": ["contracts", "{{contractId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Get OK (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "response": []
        },
        {
          "name": "Update contract",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"paymentTerms\": \"Net 45 (updated by automated test)\"\n}" },
            "url": { "raw": "{{baseUrl}}/contracts/{{contractId}}", "host": ["{{baseUrl}}"], "path": ["contracts", "{{contractId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Update OK (200)', () => pm.response.to.have.status(200));"] }
            }
          ],
          "response": []
        },
        {
          "name": "Activate contract",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/contracts/{{contractId}}/activate", "host": ["{{baseUrl}}"], "path": ["contracts", "{{contractId}}", "activate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Activate OK (201)', () => pm.response.to.have.status(201));",
                  "pm.test('Status is Active', () => pm.expect(pm.response.json().status).to.eql('Active'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Terminate contract",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Automated test termination\"\n}" },
            "url": { "raw": "{{baseUrl}}/contracts/{{contractId}}/terminate", "host": ["{{baseUrl}}"], "path": ["contracts", "{{contractId}}", "terminate"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Terminate OK (201)', () => pm.response.to.have.status(201));",
                  "pm.test('Status is Terminated', () => pm.expect(pm.response.json().status).to.eql('Terminated'));"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('Logout OK (204)', () => pm.response.to.have.status(204));"] }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
