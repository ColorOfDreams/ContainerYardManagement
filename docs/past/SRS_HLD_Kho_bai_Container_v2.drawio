        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Cache Slot trống,&lt;br&gt;tra cứu container&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeWidth=2;fillColor=#FEF2F2;strokeColor=#F87171;fontColor=#7F1D1D;fontSize=13;align=center;" vertex="1" parent="runtime-frame">
