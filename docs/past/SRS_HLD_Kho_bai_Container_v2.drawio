<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.5">
  <diagram id="hld-kho-bai-container-v2" name="HLD - Kho bai Container">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Hệ thống Quản lý Kho bãi Container — High-Level Design&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="260" y="15" width="1100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Management Service và Yard Optimize Service tách biệt hoàn toàn dữ liệu (mỗi service 1 DB riêng), giao tiếp bất đồng bộ qua Message Broker" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="230" y="58" width="1160" height="26" as="geometry" />
        </mxCell>
        <mxCell id="external-frame" value="EXTERNAL CLIENTS" style="swimlane;html=1;rounded=1;horizontal=1;startSize=38;fontStyle=1;fontSize=14;align=left;spacingLeft=14;fillColor=#F8FAFC;swimlaneFillColor=#E0F2FE;strokeColor=#94A3B8;strokeWidth=1.5;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="240" height="820" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;Web / Mobile App&lt;br&gt;Đăng nhập JWT / OAuth2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=1.5;fillColor=#EFF6FF;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="external-frame">
          <mxGeometry x="20" y="320" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="runtime-frame" value="BACKEND (DOCKER COMPOSE)" style="swimlane;html=1;rounded=1;horizontal=1;startSize=38;fontStyle=1;fontSize=14;align=left;spacingLeft=14;fillColor=#FFFFFF;swimlaneFillColor=#EDE9FE;strokeColor=#818CF8;strokeWidth=1.5;fontColor=#1E1B4B;" vertex="1" parent="1">
          <mxGeometry x="340" y="130" width="1250" height="820" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;Xác thực JWT / OAuth2&lt;br&gt;Rate limit &amp;amp; CORS&lt;br&gt;Định tuyến request&lt;br&gt;Swagger tổng hợp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="runtime-frame">
          <mxGeometry x="420" y="60" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="mgmt" value="&lt;b&gt;Management Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;CRUD nghiệp vụ:&lt;br&gt;Contract, Shipment, Container,&lt;br&gt;Yard Visit, Inspection, Movement,&lt;br&gt;Event, Invoice, Payment&lt;br&gt;GET /health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;fillColor=#ECFEFF;strokeColor=#06B6D4;fontColor=#164E63;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="runtime-frame">
          <mxGeometry x="40" y="290" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="broker" value="&lt;b&gt;Message Broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;vd: RabbitMQ / Kafka&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeWidth=2;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;fontSize=15;align=center;" vertex="1" parent="runtime-frame">
          <mxGeometry x="430" y="320" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="optimize" value="&lt;b&gt;Yard Optimize Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#475569&quot;&gt;Slot Allocation &amp;amp; Re-plan&lt;br&gt;Thuật toán scoring vị trí&lt;br&gt;Xử lý Event → tính lại Movement&lt;br&gt;GET /health&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;strokeWidth=2;fillColor=#FFF7ED;strokeColor=#FB923C;fontColor=#7C2D12;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="runtime-frame">
          <mxGeometry x="850" y="290" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="mgmt_db" value="&lt;b&gt;Management DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#475569&quot;&gt;Contract, Shipment,&lt;br&gt;YardVisit, Invoice...&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#14B8A6;fontColor=#134E4A;fontSize=13;align=center;" vertex="1" parent="runtime-frame">
