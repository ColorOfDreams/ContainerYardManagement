generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["management"]
}

enum ContractStatus {
  Draft
  Active
  Expired
  Terminated

  @@schema("management")
}

enum ContainerStatus {
  AVAILABLE
  MAINTENANCE
  DAMAGED

  @@schema("management")
}

enum ShipmentStatus {
  Planned
  InTransit @map("In Transit")
  Arrived
  Completed

  @@schema("management")
}

enum YardVisitStatus {
  PLANNED
  ARRIVED
  IN_YARD
  STAGING
  DEPARTED
  CLOSED
  REJECTED
  CANCELLED

  @@schema("management")
}

enum InspectionType {
  GateIn  @map("Gate-in")
  GateOut @map("Gate-out")
  AdHoc   @map("Ad-hoc")

  @@schema("management")
}

enum InspectionResult {
  Pass
  Fail

  @@schema("management")
}

enum InspectionFailReason {
  seal_mismatch
  physical_damage_minor
  physical_damage_severe
  other

  @@schema("management")
}

enum MovementType {
  GateIn     @map("Gate-in")
  Relocation
  Rehandle
  GateOut    @map("Gate-out")

  @@schema("management")
}

enum YardEventType {
  CustomsHold          @map("Customs Hold")
  Rejected
  Dispute
  DamageDuringMovement @map("Damage During Movement")
  OwnerRequest         @map("Owner Request")

  @@schema("management")
}

enum ResolutionStatus {
  Open
  Resolved

  @@schema("management")
}

enum InvoiceType {
  Deposit
  StorageFee      @map("Storage Fee")
  FinalSettlement @map("Final Settlement")
  Other

  @@schema("management")
}

enum PaymentStatus {
  Unpaid
  Partial
  Paid

  @@schema("management")
}

enum PaymentMethod {
  BankTransfer @map("Bank Transfer")
  Cash
  Card

  @@schema("management")
}

model Contract {
  contractId    String         @id @default(uuid()) @map("contract_id") @db.Uuid
  customerId    String         @map("customer_id") @db.Uuid
  effectiveDate DateTime       @map("effective_date") @db.Date
  expiryDate    DateTime       @map("expiry_date") @db.Date
  unitPrice     Decimal        @map("unit_price") @db.Decimal(18, 2)
  freeTimeDays  Int            @map("free_time_days")
  surchargeRate Decimal        @map("surcharge_rate") @db.Decimal(8, 4)
  paymentTerms  String?        @map("payment_terms")
  status        ContractStatus @default(Draft)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  shipments     Shipment[]
  invoices      Invoice[]

  @@index([customerId])
  @@index([status, expiryDate])
  @@map("contract")
  @@schema("management")
}

model Container {
  containerId    String              @id @default(uuid()) @map("container_id") @db.Uuid
  containerCode  String              @unique @map("container_code")
  containerType  String              @map("container_type")
  sizeTypeCode   String              @map("size_type_code")
  tareWeight     Decimal?            @map("tare_weight") @db.Decimal(12, 3)
  maxGrossWeight Decimal?            @map("max_gross_weight") @db.Decimal(12, 3)
  maxPayload     Decimal?            @map("max_payload") @db.Decimal(12, 3)
  capacity       Decimal?            @db.Decimal(12, 3)
  status         ContainerStatus     @default(AVAILABLE)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  shipmentLinks  ShipmentContainer[]

  @@index([status])
  @@map("container")
  @@schema("management")
}

model Shipment {
  shipmentId    String              @id @default(uuid()) @map("shipment_id") @db.Uuid
  contractId    String              @map("contract_id") @db.Uuid
  shipper       String
  consignee     String
  carrier       String
  origin        String?
  loadingPort   String?             @map("loading_port")
  dischargePort String?             @map("discharge_port")
  vessel        String?
  voyage        String?
  status        ShipmentStatus      @default(Planned)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  contract      Contract            @relation(fields: [contractId], references: [contractId], onDelete: Restrict)
  containers    ShipmentContainer[]

  @@index([contractId])
  @@index([status])
  @@map("shipment")
  @@schema("management")
}

model ShipmentContainer {
  shipmentContainerId String      @id @default(uuid()) @map("shipment_container_id") @db.Uuid
  shipmentId          String      @map("shipment_id") @db.Uuid
  containerId         String      @map("container_id") @db.Uuid
  sealNumber          String      @map("seal_number")
  sealType            String      @map("seal_type")
  grossWeightActual   Decimal?    @map("gross_weight_actual") @db.Decimal(12, 3)
  createdAt           DateTime    @default(now()) @map("created_at")
  shipment            Shipment    @relation(fields: [shipmentId], references: [shipmentId], onDelete: Restrict)
  container           Container   @relation(fields: [containerId], references: [containerId], onDelete: Restrict)
  cargo               Cargo[]
  yardVisits          YardVisit[]

  @@index([shipmentId])
  @@index([containerId])
  @@map("shipment_container")
  @@schema("management")
}

model Cargo {
  cargoId             String            @id @default(uuid()) @map("cargo_id") @db.Uuid
  shipmentContainerId String            @map("shipment_container_id") @db.Uuid
  cargoType           String            @map("cargo_type")
  weight              Decimal           @db.Decimal(12, 3)
  volume              Decimal?          @db.Decimal(12, 3)
  isHazardous         Boolean           @default(false) @map("is_hazardous")
  temperatureMin      Decimal?          @map("temperature_min") @db.Decimal(6, 2)
  temperatureMax      Decimal?          @map("temperature_max") @db.Decimal(6, 2)
  humidityMin         Decimal?          @map("humidity_min") @db.Decimal(5, 2)
  humidityMax         Decimal?          @map("humidity_max") @db.Decimal(5, 2)
  specialHandling     String?           @map("special_handling")
  createdAt           DateTime          @default(now()) @map("created_at")
  shipmentContainer   ShipmentContainer @relation(fields: [shipmentContainerId], references: [shipmentContainerId], onDelete: Cascade)

  @@index([shipmentContainerId])
  @@map("cargo")
  @@schema("management")
}

model YardVisit {
  yardVisitId          String            @id @default(uuid()) @map("yard_visit_id") @db.Uuid
  shipmentContainerId  String            @map("shipment_container_id") @db.Uuid
  // Slot is owned by the optimize schema; the service boundary intentionally avoids a Prisma relation here.
  currentSlotId        String?           @map("current_slot_id") @db.Uuid
  eta                  DateTime
  etd                  DateTime?
  ata                  DateTime?
  atd                  DateTime?
  freeTimeDaysSnapshot Int               @map("free_time_days_snapshot")
  status               YardVisitStatus   @default(PLANNED)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  shipmentContainer    ShipmentContainer @relation(fields: [shipmentContainerId], references: [shipmentContainerId], onDelete: Restrict)
  inspections          Inspection[]
  movements            Movement[]
  events               YardEvent[]
  invoices             Invoice[]

  @@index([shipmentContainerId])
  @@index([status, eta])
  @@index([currentSlotId])
  @@map("yard_visit")
  @@schema("management")
}

model Inspection {
  inspectionId   String                @id @default(uuid()) @map("inspection_id") @db.Uuid
  yardVisitId    String                @map("yard_visit_id") @db.Uuid
  inspectionType InspectionType        @map("inspection_type")
  sealCheck      Boolean               @map("seal_check")
  result         InspectionResult
  failReason     InspectionFailReason? @map("fail_reason")
  damageNotes    String?               @map("damage_notes")
  inspectedAt    DateTime              @default(now()) @map("inspected_at")
  inspectedBy    String?               @map("inspected_by") @db.Uuid
  yardVisit      YardVisit             @relation(fields: [yardVisitId], references: [yardVisitId], onDelete: Restrict)

  @@index([yardVisitId, inspectedAt])
  @@map("inspection")
  @@schema("management")
}

model Movement {
  movementId   String       @id @default(uuid()) @map("movement_id") @db.Uuid
  yardVisitId  String       @map("yard_visit_id") @db.Uuid
  movementType MovementType @map("movement_type")
  // Slot IDs belong to optimize; referential validation is handled by the orchestration flow.
  fromSlotId   String?      @map("from_slot_id") @db.Uuid
  toSlotId     String?      @map("to_slot_id") @db.Uuid
  reason       String?
  movedAt      DateTime     @default(now()) @map("moved_at")
  operatorId   String?      @map("operator_id") @db.Uuid
  yardVisit    YardVisit    @relation(fields: [yardVisitId], references: [yardVisitId], onDelete: Restrict)

  @@index([yardVisitId, movedAt])
  @@index([fromSlotId])
  @@index([toSlotId])
  @@map("movement")
  @@schema("management")
}

model YardEvent {
  eventId          String           @id @default(uuid()) @map("event_id") @db.Uuid
  yardVisitId      String           @map("yard_visit_id") @db.Uuid
  eventType        YardEventType    @map("event_type")
  description      String?
  requestedBy      String?          @map("requested_by")
  occurredAt       DateTime         @default(now()) @map("occurred_at")
  resolutionStatus ResolutionStatus @default(Open) @map("resolution_status")
  yardVisit        YardVisit        @relation(fields: [yardVisitId], references: [yardVisitId], onDelete: Restrict)

  @@index([yardVisitId, occurredAt])
  @@index([resolutionStatus])
  @@map("event")
  @@schema("management")
}

model Invoice {
  invoiceId             String        @id @default(uuid()) @map("invoice_id") @db.Uuid
  contractId            String        @map("contract_id") @db.Uuid
  yardVisitId           String?       @map("yard_visit_id") @db.Uuid
  invoiceType           InvoiceType   @map("invoice_type")
  actualStorageDuration Int?          @map("actual_storage_duration")
  overdueDays           Int?          @map("overdue_days")
  baseStorageFee        Decimal?      @map("base_storage_fee") @db.Decimal(18, 2)
  surchargeAmount       Decimal?      @map("surcharge_amount") @db.Decimal(18, 2)
  totalAmount           Decimal       @map("total_amount") @db.Decimal(18, 2)
  paymentStatus         PaymentStatus @default(Unpaid) @map("payment_status")
  issuedAt              DateTime      @default(now()) @map("issued_at")
  contract              Contract      @relation(fields: [contractId], references: [contractId], onDelete: Restrict)
  yardVisit             YardVisit?    @relation(fields: [yardVisitId], references: [yardVisitId], onDelete: Restrict)
  payments              Payment[]

  @@index([contractId, issuedAt])
  @@index([yardVisitId])
  @@index([paymentStatus])
  @@map("invoice")
  @@schema("management")
}

model Payment {
  paymentId     String        @id @default(uuid()) @map("payment_id") @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  amountPaid    Decimal       @map("amount_paid") @db.Decimal(18, 2)
  paymentMethod PaymentMethod @map("payment_method")
  paymentDate   DateTime      @map("payment_date")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")
  invoice       Invoice       @relation(fields: [invoiceId], references: [invoiceId], onDelete: Restrict)

  @@index([invoiceId, paymentDate])
  @@map("payment")
  @@schema("management")
}

// Authentication and authorization are owned by Management. Roles and
// permissions are data, rather than hard-coded enums, so new operations can be
// granted without a database migration.
model User {
  userId        String         @id @default(uuid()) @map("user_id") @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  displayName   String?        @map("display_name")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@index([isActive])
  @@map("user")
  @@schema("management")
}

model Role {
  roleId      String           @id @default(uuid()) @map("role_id") @db.Uuid
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
  @@schema("management")
}

model Permission {
  permissionId String           @id @default(uuid()) @map("permission_id") @db.Uuid
  code         String           @unique
  name         String
  description  String?
  createdAt    DateTime         @default(now()) @map("created_at")
  roles        RolePermission[]

  @@map("permission")
  @@schema("management")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
  @@schema("management")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  role         Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
  @@schema("management")
}

model RefreshToken {
  refreshTokenId String    @id @default(uuid()) @map("refresh_token_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_token")
  @@schema("management")
}
