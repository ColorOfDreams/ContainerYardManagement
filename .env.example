# Copy file này thành ".env" rồi điền giá trị thật (KHÔNG commit .env lên git).

# ---- PostgreSQL (1 instance, schema: management) ----
POSTGRES_USER=cyms_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=cyms
POSTGRES_PORT=5432

MANAGEMENT_DATABASE_URL=postgresql://cyms_user:change_me_locally@postgres:5432/cyms?schema=management

# ---- Redis ----
REDIS_PORT=6379

# ---- Service port (expose ra host để test trực tiếp) ----
MANAGEMENT_SERVICE_PORT=3001

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_locally
JWT_REFRESH_SECRET=change_me_locally
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Chỉ dùng khi chạy script seed để tạo Admin đầu tiên ở local/dev.
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWith6PlusCharsAndANumber
