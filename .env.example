# Copy file này thành ".env" rồi điền giá trị thật (KHÔNG commit .env lên git).

# ---- PostgreSQL (1 instance, 2 schema: management + optimize) ----
POSTGRES_USER=cyms_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=cyms
POSTGRES_PORT=5432

# Connection string cho từng service — cùng 1 DB, khác schema qua param ?schema=
MANAGEMENT_DATABASE_URL=postgresql://cyms_user:change_me_locally@postgres:5432/cyms?schema=management
OPTIMIZE_DATABASE_URL=postgresql://cyms_user:change_me_locally@postgres:5432/cyms?schema=optimize

# ---- Redis ----
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_USER=cyms_user
RABBITMQ_PASSWORD=change_me_locally
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_UI_PORT=15672

# ---- Service ports (expose ra host để test trực tiếp, không qua Gateway) ----
MANAGEMENT_SERVICE_PORT=3001
OPTIMIZE_SERVICE_PORT=3002

# ---- JWT (bổ sung khi làm Auth) ----
JWT_ACCESS_SECRET=change_me_locally
JWT_REFRESH_SECRET=change_me_locally
